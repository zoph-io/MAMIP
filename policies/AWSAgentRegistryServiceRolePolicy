{
    "PolicyVersion": {
        "Document": {
            "Version": "2012-10-17",
            "Statement": [
                {
                    "Sid": "AllowPublishCloudWatchMetrics",
                    "Effect": "Allow",
                    "Action": [
                        "cloudwatch:PutMetricData"
                    ],
                    "Resource": "*",
                    "Condition": {
                        "StringEquals": {
                            "cloudwatch:namespace": [
                                "AWS/AgentRegistry",
                                "AWS/Usage"
                            ],
                            "aws:ResourceAccount": "${aws:PrincipalAccount}"
                        }
                    }
                }
            ]
        },
        "VersionId": "v1",
        "IsDefaultVersion": true,
        "CreateDate": "2026-08-06T14:27:17+00:00"
    }
}
